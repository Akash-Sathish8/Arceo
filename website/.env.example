# Arceo marketing website — environment variables
# Copy to .env.local for local dev. On the deploy host (e.g. Railway), set these
# as BUILD-TIME variables — NEXT_PUBLIC_* values are inlined into the bundle at
# build time, not read at runtime.

# Backend API URL — server-side only, used by the Next.js rewrite that proxies
# /api/backend/* -> ${BACKEND_URL}/api/*. Defaults to http://localhost:8000.
BACKEND_URL=http://localhost:8000

# Public URL of the React dashboard app (where /login lives), used by the
# "Sign In" link. In production this is the deployed dashboard's URL (the
# backend container serves it). MUST be set at build time in production, or
# "Sign In" falls back to /book-demo. Defaults to http://localhost:5173 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:5173
