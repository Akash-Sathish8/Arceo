# Arceo marketing website — environment variables
# Copy to .env.local for local dev. On the deploy host, set these as
# BUILD-TIME variables — NEXT_PUBLIC_* values are inlined into the bundle at
# build time, not read at runtime.

# ── Required for production ────────────────────────────────────────────────

# Canonical public origin of THIS site. Used for canonical URLs, the sitemap,
# robots.txt and Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://arceo.io

# Where demo-request leads are delivered: a Slack-compatible incoming webhook.
# Runtime (server) variable. If unset, leads are only written to server logs —
# make sure someone reads those, or set this.
ARCEO_DEMO_WEBHOOK=

# ── Optional ───────────────────────────────────────────────────────────────

# Public URL of the Arceo dashboard app (where /login lives). Build-time.
# If unset on a production build, the "Sign In" link is hidden entirely.
# In local dev it defaults to http://localhost:5173.
NEXT_PUBLIC_APP_URL=

# Fallback contact email shown when the demo-request form cannot deliver.
# Runtime (server) variable. Defaults to the founder's address.
ARCEO_CONTACT_EMAIL=

# Backend API URL — server-side only, used by the Next.js rewrite that proxies
# /api/backend/* -> ${BACKEND_URL}/api/*. The marketing pages do not call it;
# leave unset unless you know you need it. Defaults to http://localhost:8000.
BACKEND_URL=
