# Copy to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=change-this-to-a-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
# Declares this host a development environment. Every boot guard keys off it:
# the default JWT secret, DEMO_MODE, encryption-at-rest and the DATABASE_URL
# fallback below are ALL refused unless this says dev/local/test/ci. Unset means
# production — that is deliberate, so forgetting it on a deploy costs you a
# startup error rather than a silently disabled protection. Never set it on a
# real deploy.
ARCEO_ENV=dev
# Postgres. Unset = the docker-compose dev default (postgres/postgres@localhost/arceo),
# and that fallback now requires ARCEO_ENV above to name a dev environment.
# Production deploys MUST set DATABASE_URL explicitly.
#
# ⚠️ Note this file is NOT auto-loaded — export these, or use `docker compose`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arceo
# Redis. REQUIRED — it is a hard dependency, not a cache. There is deliberately
# no in-memory fallback (it would silently reintroduce multi-worker bugs), and
# rate limiting fails CLOSED, so an unreachable Redis makes login, signup,
# /api/enforce and /api/scan all return 429 while /api/health still passes.
# The app refuses to boot without it outside a dev environment.
# On Google Cloud: Memorystore + a Serverless VPC connector, not an add-on.
REDIS_URL=redis://localhost:6379/0
# Whether startup runs `alembic upgrade head` itself. Default: on in dev, OFF
# on a real deploy — production runs as the restricted arceo_app role while
# migrations need the owner role. When off, the app still refuses to serve if
# the schema is behind the code. See docs/MIGRATION_RUNBOOK.md.
ARCEO_RUN_MIGRATIONS_ON_BOOT=1
# LLM-classification cache (a local SQLite file, deliberately separate from the
# app DB). Default: backend/llm_cache.db
ARCEO_LLM_CACHE_PATH=
