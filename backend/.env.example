# Copy to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=change-this-to-a-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
# Postgres. Unset = the docker-compose dev default (postgres/postgres@localhost/arceo);
# production deploys MUST set it (the app refuses to boot on prod platforms without it).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arceo
# Trust X-Forwarded-For for rate-limit keys. Leave OFF unless this app sits
# behind an ingress YOU control. When ON, ARCEO_TRUSTED_PROXY_HOPS is REQUIRED
# and the app refuses to start without it — there is no safe default:
#   0 = the client IP is the RIGHT-MOST X-Forwarded-For entry (direct Cloud Run)
#   1 = second from the right (a Google Cloud Load Balancer in front of it)
# Too low and a caller can forge their own rate-limit bucket; too high and every
# caller collapses into one and the 11th login from anyone is refused.
# TRUSTED_PROXY=
# ARCEO_TRUSTED_PROXY_HOPS=
#
# ⚠️ Do NOT set FORWARDED_ALLOW_IPS=* (the common Cloud Run recipe). uvicorn's
# ProxyHeadersMiddleware would then rewrite the peer address from the left-most,
# caller-written X-Forwarded-For entry BEFORE the app sees it, re-creating the
# spoof above even with TRUSTED_PROXY off. The Dockerfile pins the flag to
# loopback so the env var cannot take effect there.
# LLM-classification cache (a local SQLite file, deliberately separate from the
# app DB). Default: backend/llm_cache.db
ARCEO_LLM_CACHE_PATH=
